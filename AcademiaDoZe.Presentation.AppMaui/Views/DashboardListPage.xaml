<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.DashboardListPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:DashboardListViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <Border Style="{StaticResource CardBorder}" Padding="20">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Image HeightRequest="160" WidthRequest="280" Aspect="AspectFit">
                        <Image.Source>
                            <AppThemeBinding Light="academiadoze_claro.png" Dark="academiadoze_escuro.png" />
                        </Image.Source>
                    </Image>
                    <Label Text="Academia do Zé" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Secondary}"/>
                    <Label Text="Gestão Integrada &amp; Controle" FontSize="14" HorizontalTextAlignment="Center" TextColor="#64748B"/>
                </VerticalStackLayout>
            </Border>

            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="15" ColumnSpacing="15">
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToLogradourosCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label FontFamily="MaterialIcons" Text="&#xe7f1;" FontSize="28" HorizontalTextAlignment="Center" TextColor="{StaticResource Secondary}"/>
                        <Label Text="{Binding TotalLogradouros}" FontSize="32" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Secondary}"/>
                        <Label Text="Logradouros" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToAlunosCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label FontFamily="MaterialIcons" Text="&#xe80c;" FontSize="28" HorizontalTextAlignment="Center" TextColor="{StaticResource Secondary}"/>
                        <Label Text="{Binding TotalAlunos}" FontSize="32" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Secondary}"/>
                        <Label Text="Alunos" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToColaboradoresCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label FontFamily="MaterialIcons" Text="&#xea67;" FontSize="28" HorizontalTextAlignment="Center" TextColor="{StaticResource Secondary}"/>
                        <Label Text="{Binding TotalColaboradores}" FontSize="32" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Secondary}"/>
                        <Label Text="Colaboradores" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToMatriculasCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label FontFamily="MaterialIcons" Text="&#xefec;" FontSize="28" HorizontalTextAlignment="Center" TextColor="{StaticResource Secondary}"/>
                        <Label Text="{Binding TotalMatriculas}" FontSize="32" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Secondary}"/>
                        <Label Text="Matrículas" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>